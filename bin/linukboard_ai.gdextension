[configuration]

entry_symbol = "linukboard_ai_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/liblinukboard_ai.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/liblinukboard_ai.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/liblinukboard_ai.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/liblinukboard_ai.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/liblinukboard_ai.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/liblinukboard_ai.linux.template_release.arm64.so"
macos.debug = "res://bin/liblinukboard_ai.macos.template_debug.framework"
macos.release = "res://bin/liblinukboard_ai.macos.template_release.framework"
